# Copiá este archivo como .env y completá los valores.

# Base de datos Postgres (Supabase): Project Settings → Database → Connection string → "Session pooler".
# Reemplazá [YOUR-PASSWORD] por la contraseña de la base.
DATABASE_URL=

# Clave de la API de Claude. La conseguís en https://platform.claude.com/ (sección API Keys).
ANTHROPIC_API_KEY=

# Opcional
# PORT=3000
# CLAUDE_MODEL=claude-opus-5-5
# TZ=America/Argentina/Buenos_Aires
