{
  "name": "agenda-inteligente-crm",
  "version": "1.0.0",
  "description": "CRM de ventas con Agenda Inteligente, el asistente comercial (Claude).",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "reset-db": "node --env-file-if-exists=.env src/reset-db.js",
    "backup": "node --env-file-if-exists=.env src/backup.js",
    "restaurar": "node --env-file-if-exists=.env src/restaurar.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
